 use super::*;
 use std::panic::{AssertUnwindSafe, catch_unwind};
 
+#[cfg(feature = "python")]
+pub(super) fn execute_readonly<T: IntegrationTask>(
+    task: &T,
+    integrator: &Integrator,
+    array: &pyo3::Py<numpy::PyArray2<f64>>,
+) -> Result<T::Output, String> {
+    use numpy::{PyArrayMethods, PyUntypedArrayMethods};
+    pyo3::Python::attach(|py| {
+        let guard = array.bind(py).try_readonly().map_err(|e| e.to_string())?;
+        let shape = guard.shape();
+        let (h, w) = (shape[0], shape[1]);
+        let data = guard.as_slice().map_err(|e| e.to_string())?;
+        // The Python owner and read guard remain alive outside detach. Only
+        // the plain slice crosses into native computation; no raw pointers.
+        py.detach(|| {
+            catch_unwind(AssertUnwindSafe(|| {
+                task.execute_slice(integrator, data, h, w)
+            }))
+            .map_err(|_| "integration worker panicked".to_owned())
+        })
+    })
+}
