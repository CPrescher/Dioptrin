@@ -0,0 +1,108 @@
+"""Ownership, backpressure and numerical regressions for borrowed streams."""
+import faulthandler
+import gc
+import unittest
+import weakref
+
+import dioptrin
+import numpy as np
+
+PONI = dict(pixel1=1e-4, pixel2=1e-4, distance=.1,
+            poni1=.0016, poni2=.0032, wavelength=1e-10)
+
+
+def make_ai(method='pixel_split', fast=True):
+    return dioptrin.Integrator.from_poni_dict(
+        PONI, method=method, n_ss=3, polarization_factor=.965, fast_math=fast)
+
+
+def readonly(value):
+    value.setflags(write=False)
+    return value
+
+
+class StreamBorrowingTests(unittest.TestCase):
+    def setUp(self):
+        faulthandler.dump_traceback_later(30, exit=True)
+
+    def tearDown(self):
+        faulthandler.cancel_dump_traceback_later()
+
+    def same(self, actual, expected):
+        for key in ['radial', 'intensity', 'errors', 'azimuthal_std']:
+            a, b = getattr(actual, key), getattr(expected, key)
+            if b is None:
+                self.assertIsNone(a)
+            else:
+                np.testing.assert_array_equal(a, b)
+                self.assertEqual(np.asarray(a).tobytes(), np.asarray(b).tobytes(), key)
+
+    def test_modes_workers_order_and_repeated_images(self):
+        rng = np.random.default_rng(42)
+        a = readonly(rng.uniform(-2, 200, (32, 64)))
+        b = readonly(rng.uniform(-2, 200, (32, 64)))
+        frames = [a, b] * 20  # exceeds every tested queue's capacity
+        mask = np.zeros(a.shape, dtype=np.uint8);mask[0:2] = 1
+        for method in ['counting', 'histogram', 'pixel_split', 'supersampled']:
+            for fast in [False, True]:
+                for errors in [False, True]:
+                    for spread in [False, True]:
+                        ai = make_ai(method, fast);ai.set_mask(mask)
+                        expected = [ai.integrate1d(x, 40, errors=errors, azimuthal_std=spread) for x in [a, b]]
+                        for workers in [1, 2, 4, 8]:
+                            with self.subTest(method=method, fast=fast, errors=errors, spread=spread, workers=workers):
+                                actual = list(ai.batch1d_iter(iter(frames), 40, errors=errors,
+                                    azimuthal_std=spread, num_workers=workers, num_threads=1, copy_arrays=False))
+                                self.assertEqual(len(actual), len(frames))
+                                for i, item in enumerate(actual):
+                                    self.assertTrue(item.is_ok(), item.error)
+                                    self.same(item.result, expected[i % 2])
+
+    def test_default_preserves_a_generator_overwriting_one_buffer(self):
+        ai = make_ai();buffer = np.empty((32, 64))
+        expected = [ai.integrate1d(np.full(buffer.shape, float(i)), 40) for i in range(40)]
+        def frames():
+            for i in range(40):
+                buffer.fill(i)
+                yield buffer
+        actual = list(ai.batch1d_iter(frames(), 40, num_workers=4, num_threads=1))
+        self.assertEqual(len(actual), 40)
+        for item, wanted in zip(actual, expected):self.same(item.result, wanted)
+        self.assertTrue(buffer.flags.writeable)
+
+    def test_owner_survives_parent_and_iterator_lifetime(self):
+        ai = make_ai();frames = [readonly(np.full((32, 64), float(i+1))) for i in range(40)]
+        expected = [ai.integrate1d(x, 40, errors=True) for x in frames]
+        refs = [weakref.ref(x) for x in frames]
+        stream = ai.batch1d_iter(iter(frames), 40, errors=True, num_workers=4, num_threads=1, copy_arrays=False)
+        del frames, ai;gc.collect()
+        actual = list(stream)
+        self.assertEqual(len(actual), 40)
+        for item, wanted in zip(actual, expected):self.same(item.result, wanted)
+        del stream;gc.collect()
+        self.assertTrue(all(ref() is None for ref in refs))
+
+    def test_bad_array_and_generator_error_are_reported_without_deadlock(self):
+        ai = make_ai()
+        for image in [np.ones((32, 64)), readonly(np.ones((32, 64)))[:, ::2], readonly(np.ones((32, 64), dtype='float32'))]:
+            items = list(ai.batch1d_iter(iter([image]), 40, num_workers=1, num_threads=1, copy_arrays=False))
+            self.assertEqual(len(items), 1)
+            self.assertFalse(items[0].is_ok())
+        def broken():
+            for i in range(40):yield readonly(np.full((32, 64), float(i)))
+            raise ValueError('reader failed after frame 40')
+        items = list(ai.batch1d_iter(broken(), 40, num_workers=1, num_threads=1, copy_arrays=False))
+        self.assertEqual(len(items), 41)
+        self.assertTrue(all(x.is_ok() for x in items[:40]))
+        self.assertIn('reader failed after frame 40', items[-1].error)
+        self.assertTrue(ai.batch1d([np.ones((32, 64))], 40)[0].is_ok())
+
+    def test_readonly_list_and_empty_input(self):
+        ai = make_ai();image = readonly(np.ones((32, 64)))
+        results = list(ai.batch1d_iter([image, image], 40, copy_arrays=False, num_workers=2, num_threads=1))
+        self.assertEqual(len(results), 2)
+        for result in results:self.same(result.result, ai.integrate1d(image, 40))
+        self.assertEqual(list(ai.batch1d_iter([], 40, copy_arrays=False)), [])
+
+
+if __name__ == '__main__':unittest.main()
