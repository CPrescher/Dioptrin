+        // obtain their own read guard before releasing it for computation.
+        let readonly: PyReadonlyArray2<'_, f64> = item.extract()?;
+        extract_array_dims(&readonly, "float64")?;
+        readonly
+            .as_slice()
+            .map_err(|_| PyValueError::new_err("Array must be contiguous"))?;
+        return Ok(WorkItem::ReadonlyArray {
+            index,
+            name: format!("iter[{index}]"),
+            array: array.clone().unbind(),
+        });
+    }
+    Ok(match extract_frame_from_pyany(item, index)? {
+        FrameOrPath::Path(path) => WorkItem::Path { index, path },
+        FrameOrPath::Frame(frame) => WorkItem::Frame {
+            index,
+            name: frame.name.clone(),
+            frame,
+        },
+    })
+}
